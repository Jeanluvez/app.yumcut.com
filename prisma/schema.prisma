// ============================================================
// Sprokl — Prisma Schema
// Stack: Next.js + Supabase (PostgreSQL) + Clerk + Stripe
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Plan {
  free
  pro
  business
}

enum Language {
  en
  es
}

enum AspectRatio {
  vertical_9_16
  square_1_1
  horizontal_16_9
}

enum ProjectStatus {
  draft
  scripts_generated
  generating
  done
  failed
}

enum AssetType {
  video
  image
  hook
}

enum JobStatus {
  pending
  processing
  done
  failed
}

enum ChannelPlatform {
  tiktok
  instagram_reels
  youtube_shorts
}

enum ChannelStatus {
  connected
  disconnected
}

// ============================================================
// 1. USERS
// ============================================================

model User {
  id                       String    @id               // Clerk user ID
  email                    String    @unique
  plan                     Plan      @default(free)
  stripeCustomerId         String?   @map("stripe_customer_id")
  stripeSubscriptionId     String?   @map("stripe_subscription_id")

  // 套餐用量控制
  generationCountThisMonth Int       @default(0) @map("generation_count_this_month")
  generationResetAt        DateTime  @default(now()) @map("generation_reset_at") // 每月1日重置
  storageUsedBytes         BigInt    @default(0) @map("storage_used_bytes")

  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Relations
  projects                 Project[]
  assets                   Asset[]
  videos                   Video[]
  channels                 ChannelConnection[]

  @@map("users")
}

// ============================================================
// 2. PROJECTS
// ============================================================

model Project {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")

  // 基本信息
  name               String                              // 项目名称，用户自定义
  productName        String        @map("product_name")
  productDescription String        @map("product_description")
  sellingPoints      String        @map("selling_points")
  targetAudience     String        @map("target_audience")

  // 促销信息（可选）
  promoEnabled       Boolean       @default(false) @map("promo_enabled")
  promoInfo          Json?         @map("promo_info")
  // promoInfo 结构:
  // {
  //   originalPrice: string,
  //   salePrice: string,
  //   offerText: string
  // }

  // 素材选择
  selectedAssetIds   String[]      @map("selected_asset_ids") // 从素材库选择的 asset IDs
  hookAssetId        String?       @map("hook_asset_id")      // 可选 Hook 视频

  // 视频参数
  durationSeconds    Int           @map("duration_seconds")   // 30 | 60 | 90
  aspectRatio        AspectRatio   @default(vertical_9_16) @map("aspect_ratio")
  language           Language      @default(en)

  // 状态
  status             ProjectStatus @default(draft)

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts            Script[]
  videoJobs          VideoJob[]
  videos             Video[]

  @@map("projects")
}

// ============================================================
// 3. ASSETS（素材库）
// ============================================================

model Asset {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  projectId    String?   @map("project_id")   // 首次上传时关联的项目（可选）

  type         AssetType
  filename     String
  storageUrl   String    @map("storage_url")
  thumbnailUrl String?   @map("thumbnail_url") // 视频/图片缩略图

  // 文件元数据
  sizeBytes    BigInt    @map("size_bytes")
  mimeType     String    @map("mime_type")     // e.g. "video/mp4", "image/jpeg"

  // 视频专属字段
  durationSeconds Float? @map("duration_seconds") // 视频时长（秒）
  width           Int?                            // 分辨率宽
  height          Int?                            // 分辨率高

  expiresAt    DateTime  @map("expires_at")    // 按套餐设置有效期
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assets")
}

// ============================================================
// 4. SCRIPTS（AI 生成脚本）
// ============================================================

model Script {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")

  // 脚本内容
  styleLabel  String    @map("style_label")   // AI 自动命名风格，如 "Before & After"
  hookText    String    @map("hook_text")
  bodyText    String    @map("body_text")
  ctaText     String    @map("cta_text")
  estimatedDurationSeconds Int? @map("estimated_duration_seconds")

  // AI 原始内容备份（用户编辑后可对比还原）
  originalHookText String @map("original_hook_text")
  originalBodyText String @map("original_body_text")
  originalCtaText  String @map("original_cta_text")

  // 用户操作
  isSelected  Boolean   @default(true) @map("is_selected") // 是否勾选参与生成
  sortOrder   Int       @map("sort_order")                  // 展示顺序 1 | 2 | 3
  editedAt    DateTime? @map("edited_at")                   // 最后编辑时间

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoJobs   VideoJob[]

  @@map("scripts")
}

// ============================================================
// 5. VIDEO_JOBS（异步任务队列）
// ============================================================

model VideoJob {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  scriptId      String    @map("script_id")
  variantIndex  Int       @map("variant_index") // 1 | 2 | 3

  // 任务状态
  status        JobStatus @default(pending)
  retryCount    Int       @default(0) @map("retry_count") // 最多重试 3 次
  errorMessage  String?   @map("error_message")

  // 中间产物存储路径（Railway 处理过程中写入）
  voiceoverUrl        String? @map("voiceover_url")         // TTS 音频文件
  ttsTimestampsUrl    String? @map("tts_timestamps_url")    // 逐词时间戳 JSON（字幕对齐用）
  rawFootageUrl       String? @map("raw_footage_url")       // 素材拼接后的中间视频
  musicUrl            String? @map("music_url")             // 本次使用的背景音乐
  finalUrl            String? @map("final_url")             // 最终合成 MP4 路径

  // 时间记录
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")    // 开始处理时间（区别于创建时间）
  completedAt   DateTime? @map("completed_at")  // 完成时间

  // Relations
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  script        Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  video         Video?

  @@map("video_jobs")
}

// ============================================================
// 6. VIDEOS（视频成品）
// ============================================================

model Video {
  id              String    @id @default(uuid())
  jobId           String    @unique @map("job_id")   // 一个 job 对应一个成品视频
  userId          String    @map("user_id")
  projectId       String    @map("project_id")

  // 文件信息
  storageUrl      String    @map("storage_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  durationSeconds Int       @map("duration_seconds")
  fileSizeBytes   BigInt    @map("file_size_bytes")   // 文件大小，展示 + 存储统计用

  // 展示信息
  variantLabel    String?   @map("variant_label")     // 如 "风格一：震撼对比"，Workspace 展示用

  // 用量统计
  downloadCount   Int       @default(0) @map("download_count") // 下载次数，产品数据

  // 有效期
  expiresAt       DateTime  @map("expires_at")        // Free:7天 Pro:30天 Business:90天

  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  job             VideoJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("videos")
}

// ============================================================
// 7. CHANNEL CONNECTIONS（发布账号连接）
// ============================================================

model ChannelConnection {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  platform    ChannelPlatform
  displayName String         @map("display_name")
  handle      String? 
  status      ChannelStatus   @default(connected)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("channel_connections")
}
